# ============================================================================
# Edgebet — environment variables
# Copy this file to .env and fill in values. Never commit .env.
# ============================================================================

# --- Database ---
# Docker Compose overrides this to point to the db container.
# For local dev without Docker, use SQLite:
# USE_SQLITE=true
DATABASE_URL=postgresql://edgebet:edgebet@localhost:5432/edgebet

# --- Auth ---
EDGEBET_JWT_SECRET=change-this-to-a-random-64-char-string

# --- Claude API (narrativas de picks) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- The Odds API (odds en tiempo real) ---
# https://the-odds-api.com — registrate gratis, 500 req/mes.
# Tier `free` (default): h2h + spreads + totals. DC, BTTS, team_totals, spread
# se derivan matemáticamente de Poisson (no consumen requests extra). Múltiples
# líneas OU se obtienen agregando cross-bookmaker (best price disponible).
# Tier `starter` ($30/mo) o `pro` ($59/mo): habilita alternate_totals, btts,
# double_chance, draw_no_bet, team_totals reales del provider.
EDGEBET_ODDS_API_KEY=
EDGEBET_ODDS_TIER=free

# --- football-data.org (histórico de selecciones para Poisson) ---
# https://www.football-data.org — free tier. Solo expone la temporada ACTUAL de
# cada competición (las históricas devuelven 403). Nacionales en free tier:
# WC (Mundial) y EC (EURO). Sin esta key, el Mundial cae a estimación por ELO.
FOOTBALL_DATA_API_KEY=

# --- Stripe (pagos Pro/VIP) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_VIP=price_yyy

# --- Telegram Bot (Sprint 4) ---
# https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
